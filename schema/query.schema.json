{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query.schema.json",
  "title": "FortiSIEM Community Query Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "slug",
    "title",
    "origin",
    "platform",
    "query_type",
    "dialect",
    "category",
    "scope",
    "summary",
    "parameters",
    "privacy",
    "compatibility",
    "references",
    "license"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../../schema/query.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^FSQ-[A-Z]+-[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "id",
        "source",
        "reviewed_by_maintainer"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 8
        },
        "id": {
          "type": "string",
          "minLength": 8
        },
        "source": {
          "type": "string",
          "enum": [
            "maintainer",
            "ai-assisted"
          ]
        },
        "reviewed_by_maintainer": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "author",
        "third_party_code_included"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "original-work",
            "contributed-original-work"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "third_party_code_included": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "platform": {
      "type": "string",
      "const": "FortiSIEM"
    },
    "query_type": {
      "type": "string",
      "enum": [
        "advanced-search",
        "analytics-search",
        "report-query"
      ]
    },
    "dialect": {
      "type": "string",
      "enum": [
        "ClickHouse SQL"
      ]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_on",
        "removed_categories"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "sanitized"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "removed_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentation_reference_version",
        "tested_versions",
        "execution_validation"
      ],
      "properties": {
        "documentation_reference_version": {
          "type": "string",
          "minLength": 1
        },
        "tested_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_validation": {
          "type": "string",
          "enum": [
            "not-independently-executed",
            "maintainer-tested",
            "community-tested"
          ]
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "publisher",
          "url",
          "accessed_on"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "publisher": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "license": {
      "type": "string",
      "const": "MIT"
    }
  }
}